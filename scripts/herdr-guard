#!/usr/bin/env bash
# Cooperative accident guard. It prevents casual raw mutations but is not a
# security boundary against another process running as the same user.

set -euo pipefail

real=${IPSE_HERDR_REAL_BIN:-"$HOME/.local/libexec/herdr-real"}
[[ -x "$real" ]] || {
  printf 'Herdr runtime missing: %s\n' "$real" >&2
  exit 127
}

if [[ ${IPSE_HERDR_DISPATCH:-} == 1 ]]; then
  unset IPSE_HERDR_DISPATCH
  exec "$real" "$@"
fi

args=("$@")
i=0
command=
while (( i < ${#args[@]} )); do
  value=${args[$i]}
  case "$value" in
    --session|--remote|--remote-keybindings)
      (( i + 1 < ${#args[@]} )) || { printf 'Invalid Herdr options.\n' >&2; exit 2; }
      ((i += 2))
      ;;
    --handoff|--default-config)
      ((i += 1))
      ;;
    --help|-h|--version|--skill)
      exec "$real" "${args[@]}"
      ;;
    --*)
      printf 'Blocked unapproved Herdr option: %s\n' "$value" >&2
      exit 64
      ;;
    *)
      command=$value
      break
      ;;
  esac
done

subcommand=${args[$((i + 1))]:-}
allowed=0
case "$command" in
  status|completion) allowed=1 ;;
  agent)
    case "$subcommand" in list|get|read|wait|explain) allowed=1 ;; esac
    ;;
  pane)
    case "$subcommand" in list|current|get|layout|process-info|neighbor|edges|read|wait-output) allowed=1 ;; esac
    ;;
  session)
    [[ "$subcommand" == list ]] && allowed=1
    ;;
  workspace)
    [[ "$subcommand" == list ]] && allowed=1
    ;;
  integration)
    [[ "$subcommand" == status ]] && allowed=1
    ;;
esac

if (( allowed == 1 )); then
  exec "$real" "${args[@]}"
fi

printf 'Blocked raw Herdr mutation by cooperative guard. Use dispatch_worker.py.\n' >&2
printf 'Manual recovery binary: %s\n' "$real" >&2
exit 64
